# =====================================================================
# FASE C (parte 2) - Sensibilidad del EM: inicios aleatorios, tolerancias y casos degenerados
# Proyecto final - Computación Estadística 2026-II - GRUPO 2 - GBP/USD
# Requiere: funciones_EM.R
# =====================================================================
set.seed(2026)
source("funciones_EM.R")
archivo <- "retornos_diarios_12_series.csv"
candidatos <- c(file.path("data", archivo), archivo)
ruta <- candidatos[file.exists(candidatos)][1]
if (is.na(ruta)) stop("No encuentro el CSV. Carpeta actual: ", getwd())
datos <- read.csv(ruta, stringsAsFactors = FALSE, encoding = "UTF-8")
gbp <- datos[datos$serie == "GBP/USD", ]; gbp <- gbp[order(gbp$t), ]
r <- gbp$retorno_pct; n <- length(r); s <- sd(r)
# ---- Versión "diagnóstica" del bucle EM: no se detiene con error, informa el estado ----------
# (la lógica de los pasos E y M es la misma de funciones_EM.R)
em_diag <- function(x, theta0, tol = 1e-8, max_iter = 2000) {
theta <- theta0; ll <- loglik(x, theta); estado <- "no convergió (max_iter)"
for (it in 1:max_iter) {
gamma <- paso_E(x, theta)
theta <- paso_M(x, gamma)
ll_nuevo <- loglik(x, theta)
if (!is.finite(ll_nuevo) || any(!is.finite(unlist(theta)))) { estado <- "colapso (valor no finito)"; break }
ll <- c(ll, ll_nuevo)
if (abs(ll_nuevo - ll[length(ll) - 1]) < tol) { estado <- "convergió"; break }
}
list(theta = theta, ll = ll, iter = it, estado = estado)
}
# Etiquetado: el componente 1 es el de menor desviación (calma); si se intercambian, pi -> 1 - pi
ordenar <- function(theta) {
if (all(is.finite(unlist(theta))) && theta$sigma[1] > theta$sigma[2])
list(pi = 1 - theta$pi, mu = rev(theta$mu), sigma = rev(theta$sigma)) else theta
}
fila <- function(nombre, ini, out) {
th <- ordenar(out$theta)
data.frame(inicio = nombre, pi0 = ini$pi, sigma0_1 = ini$sigma[1], sigma0_2 = ini$sigma[2],
estado = out$estado, iter = out$iter, ll_final = out$ll[length(out$ll)],
pi_calma = th$pi, sigma_calma = th$sigma[1], sigma_turb = th$sigma[2],
stringsAsFactors = FALSE)
}
# ---- 1. Doce inicios aleatorios ------------------------------------------------------------------
n_ini <- 12
inicios <- lapply(1:n_ini, function(k)
list(pi = runif(1, 0.1, 0.9), mu = runif(2, -s, s), sigma = runif(2, 0.1 * s, 2 * s)))
salidas <- lapply(inicios, function(ini) em_diag(r, ini))
tab_ini <- do.call(rbind, lapply(1:n_ini, function(k) fila(paste0("I", k), inicios[[k]], salidas[[k]])))
cat("== 12 inicios aleatorios (tol = 1e-8); componente 1 = el de menor desviación ==\n")
print(tab_ini, digits = 5, row.names = FALSE)
ok <- tab_ini$estado == "convergió"
mejor <- max(tab_ini$ll_final[ok])
cat("\nInicios que convergieron:", sum(ok), "de", n_ini, "\n")
cat("Inicios con log-verosimilitud final a menos de 1e-3 de la mejor:",
sum(ok & abs(tab_ini$ll_final - mejor) < 1e-3), "\n")
cat("Rango de pi_calma entre los convergidos:", range(tab_ini$pi_calma[ok]), "\n")
cat("Mejor log-verosimilitud:", mejor, "\n")
# ---- 2. Tolerancias de parada ---------------------------------------------------------------------
ini_base <- list(pi = 0.7, mu = c(mean(r), mean(r)), sigma = c(0.5 * s, 2 * s))
tols <- c(1e-4, 1e-6, 1e-8, 1e-10)
tab_tol <- do.call(rbind, lapply(tols, function(tl) {
out <- em_diag(r, ini_base, tol = tl); th <- ordenar(out$theta)
data.frame(tol = tl, iter = out$iter, ll_final = out$ll[length(out$ll)],
pi_calma = th$pi, sigma_calma = th$sigma[1], sigma_turb = th$sigma[2])
}))
cat("\n== Efecto de la tolerancia de parada (mismo inicio) ==\n")
print(tab_tol, digits = 8, row.names = FALSE)
# ---- 3. Casos degenerados --------------------------------------------------------------------------
i_max <- which.max(abs(r))
deg <- list(
"componentes identicos"          = list(pi = 0.5,  mu = c(0, 0),     sigma = c(s, s)),
"estrecho en 0, sigma=0.03"      = list(pi = 0.05, mu = c(0, 0),     sigma = c(0.03, s)),
"estrecho en 0, sigma=0.01"      = list(pi = 0.05, mu = c(0, 0),     sigma = c(0.01, s)),
"estrecho en max|r|, sigma=0.01" = list(pi = 0.01, mu = c(r[i_max], 0), sigma = c(0.01, s)))
tab_deg <- do.call(rbind, lapply(names(deg), function(nm) {
out <- em_diag(r, deg[[nm]], max_iter = 500)
data.frame(inicio = nm, estado = out$estado, iter = out$iter,
ll_ultima_finita = out$ll[length(out$ll)],
pi_final = out$theta$pi, sigma_min_final = min(out$theta$sigma),
stringsAsFactors = FALSE)
}))
cat("\n== Casos degenerados ==\n")
print(tab_deg, digits = 6, row.names = FALSE)
cat("Proporción de ceros exactos en los datos:", mean(r == 0), "\n")
cat("Log-verosimilitud de una sola normal (referencia):",
sum(log(dnorm_propia(r, mean(r), sqrt(mean((r - mean(r))^2))))), "\n")
# ---- 4. Gráfico: trayectorias de log-verosimilitud de los 12 inicios -----------------------------------
dir.create("figuras", showWarnings = FALSE)
png("figuras/07_inicios_EM.png", width = 1400, height = 560, res = 130)
par(mfrow = c(1, 2))
mx <- max(sapply(salidas, function(o) length(o$ll)))
plot(NA, xlim = c(0, mx), ylim = c(-2140, mejor), xlab = "iteración",
ylab = "log-verosimilitud", main = "12 inicios aleatorios")
for (o in salidas) lines(0:(length(o$ll) - 1), o$ll, col = "grey40")
plot(NA, xlim = c(0, mx), ylim = c(mejor - 0.05, mejor + 0.005), xlab = "iteración",
ylab = "log-verosimilitud", main = "Zoom cerca del máximo")
for (o in salidas) lines(0:(length(o$ll) - 1), o$ll, col = "grey40")
abline(h = mejor, lty = 2, col = "red")
dev.off()
dir.create("resultados", showWarnings = FALSE)
saveRDS(list(tab_ini = tab_ini, tab_tol = tab_tol, tab_deg = tab_deg), "resultados/EM_inicios.rds")
cat("\nGuardado: resultados/EM_inicios.rds y figuras/07_inicios_EM.png\n")
# =====================================================================
# FASE C (parte 3) - BIC frente a una normal, interpretación de los regímenes y cola implicada
# Proyecto final - Computación Estadística 2026-II - GRUPO 2 - GBP/USD
# Requiere: funciones_EM.R y resultados/params_A.rds (de 02_mle.R)
# =====================================================================
set.seed(2026)
source("funciones_EM.R")
pA <- readRDS("resultados/params_A.rds")
archivo <- "retornos_diarios_12_series.csv"
candidatos <- c(file.path("data", archivo), archivo)
ruta <- candidatos[file.exists(candidatos)][1]
if (is.na(ruta)) stop("No encuentro el CSV. Carpeta actual: ", getwd())
datos <- read.csv(ruta, stringsAsFactors = FALSE, encoding = "UTF-8")
gbp <- datos[datos$serie == "GBP/USD", ]; gbp <- gbp[order(gbp$t), ]
r <- gbp$retorno_pct; n <- length(r); s <- sd(r)
# ---- 1. Modelo final: EM con tolerancia 1e-10; componente 1 = calma (menor desviación) -----------
ini_base <- list(pi = 0.7, mu = c(mean(r), mean(r)), sigma = c(0.5 * s, 2 * s))
fit <- em_mezcla(r, ini_base, tol = 1e-10)
th <- fit$theta
if (th$sigma[1] > th$sigma[2])
th <- list(pi = 1 - th$pi, mu = rev(th$mu), sigma = rev(th$sigma))
ll_mez <- loglik(r, th)
cat("EM final: iteraciones =", fit$iter, "| log-verosimilitud =", ll_mez, "\n")
# ---- 2. Comparación con UNA sola normal (BIC y AIC) ---------------------------------------------------
mu0 <- mean(r); sg0 <- sqrt(mean((r - mu0)^2))               # MLE de la normal única
ll_nor <- sum(log(dnorm_propia(r, mu0, sg0)))
tab_bic <- data.frame(
modelo = c("Normal única", "Mezcla de 2 normales"),
parametros = c(2, 5),
logLik = c(ll_nor, ll_mez))
tab_bic$AIC <- 2 * tab_bic$parametros - 2 * tab_bic$logLik
tab_bic$BIC <- tab_bic$parametros * log(n) - 2 * tab_bic$logLik
cat("\n== Normal única frente a mezcla ==\n")
print(tab_bic, digits = 7, row.names = FALSE)
cat("Delta BIC (normal - mezcla):", tab_bic$BIC[1] - tab_bic$BIC[2], "\n")
cat("Estadístico de razón de verosimilitud 2*(ll_mezcla - ll_normal):", 2 * (ll_mez - ll_nor),
"(NO se compara con una chi-cuadrado: ver informe)\n")
# ---- 3. Interpretación de los regímenes ---------------------------------------------------------------------
gamma  <- paso_E(r, th)           # P(calma | dato)
p_turb <- 1 - gamma               # P(turbulencia | dato)
tab_reg <- data.frame(
regimen = c("Calma", "Turbulencia"),
proporcion = c(th$pi, 1 - th$pi),
media = th$mu, desviacion = th$sigma)
cat("\n== Regímenes ==\n")
print(tab_reg, digits = 6, row.names = FALSE)
cat("Probabilidad media de turbulencia:", mean(p_turb), "(debe ser 1 - pi)\n")
cat("Días con P(turbulencia) > 0.5:", sum(p_turb > 0.5), "(", mean(p_turb > 0.5), ")\n")
cat("Días con P(turbulencia) > 0.9:", sum(p_turb > 0.9), "(", mean(p_turb > 0.9), ")\n")
cat("Días con P(turbulencia) > 0.99:", sum(p_turb > 0.99), "(", mean(p_turb > 0.99), ")\n")
cat("P(turbulencia) media en los días de retorno exactamente cero:", mean(p_turb[r == 0]), "\n")
cambios <- sum((p_turb[-1] > 0.5) != (p_turb[-n] > 0.5))
cat("Cambios de régimen día a día (corte 0.5):", cambios, "| racha media (días):", n / (cambios + 1), "\n")
orden <- order(-p_turb)
cat("15 días (t) con mayor P(turbulencia):", sort(orden[1:15]), "\n")
# ---- 4. Gráfico de la probabilidad de turbulencia en el tiempo ------------------------------------------------
dir.create("figuras", showWarnings = FALSE)
w <- 60
cs <- cumsum(c(0, p_turb))
media_movil <- (cs[(w + 1):(n + 1)] - cs[1:(n - w + 1)]) / w     # media móvil de w días
png("figuras/08_prob_turbulencia.png", width = 1400, height = 560, res = 130)
plot(gbp$t, p_turb, pch = 16, cex = 0.35, col = "grey60", ylim = c(0, 1),
xlab = "t (día)", ylab = "P(turbulencia | retorno)",
main = "Probabilidad diaria de pertenecer al régimen turbulento")
lines((1:(n - w + 1)) + (w - 1) / 2, media_movil, col = "red", lwd = 2)
abline(h = 0.5, lty = 2)
legend("topleft", c("Probabilidad diaria", paste("Media móvil de", w, "días")),
pch = c(16, NA), lty = c(NA, 1), col = c("grey60", "red"), lwd = c(NA, 2), bty = "n")
dev.off()
# ---- 5. Cola implicada: P(|r| > percentil 99 de los datos) ------------------------------------------------------
erf_propia <- function(z) {
k <- 0:60; fact <- c(1, cumprod(1:60))
sapply(z, function(zz) 2 / sqrt(pi) * sum((-1)^k * zz^(2 * k + 1) / (fact * (2 * k + 1))))
}
cola_normal <- function(z) 0.5 * (1 - erf_propia(z / sqrt(2)))      # 1 - Phi(z), para z >= 0
# P(|X| > q) si X ~ N(mu, sigma^2):  P(X > q) + P(X < -q)
p_abs <- function(q, mu, sigma) cola_normal((q - mu) / sigma) + cola_normal((q + mu) / sigma)
q99 <- quantile(abs(r), 0.99, type = 7, names = FALSE)          # percentil 99 de |r| (retornos originales)
obs <- mean(abs(r) > q99)
p_mezcla <- th$pi * p_abs(q99, th$mu[1], th$sigma[1]) + (1 - th$pi) * p_abs(q99, th$mu[2], th$sigma[2])
p_normal <- p_abs(q99, mu0, sg0)
p_weib   <- exp(-(q99 / pA$lam_w)^pA$k_w)                       # modelo de la Fase A (sin ceros)
p0       <- mean(r == 0)
tab_cola <- data.frame(
fuente = c("Frecuencia observada", "Mezcla de 2 normales", "Weibull (Fase A)",
"Weibull (Fase A) x (1 - proporción de ceros)", "Normal única"),
probabilidad = c(obs, p_mezcla, p_weib, p_weib * (1 - p0), p_normal))
tab_cola$razon_vs_observada <- tab_cola$probabilidad / obs
cat("\n== Cola implicada: P(|r| >", q99, ") ==\n")
cat("Datos que superan el percentil 99:", sum(abs(r) > q99), "de", n, "\n")
print(tab_cola, digits = 5, row.names = FALSE)
# Verificación con la función de la librería (NO oficial)
pn <- function(z) pnorm(z)
v_mez <- th$pi * ((1 - pn((q99 - th$mu[1]) / th$sigma[1])) + pn((-q99 - th$mu[1]) / th$sigma[1])) +
(1 - th$pi) * ((1 - pn((q99 - th$mu[2]) / th$sigma[2])) + pn((-q99 - th$mu[2]) / th$sigma[2]))
cat("Verificación con pnorm (solo comprobación) - mezcla:", v_mez, " propio:", p_mezcla, "\n")
dir.create("resultados", showWarnings = FALSE)
saveRDS(list(theta = th, iter = fit$iter, tab_bic = tab_bic, tab_reg = tab_reg,
tab_cola = tab_cola, p_turb = p_turb, q99 = q99), "resultados/EM_final.rds")
cat("\nGuardado: resultados/EM_final.rds y figuras/08_prob_turbulencia.png\n")
# Ejecuta todo el proyecto de principio a fin (cada script fija su propia semilla: set.seed(2026))
# Uso: abrir R en la carpeta del proyecto y ejecutar  source("run_all.R")
# Archivos de funciones (se cargan con source() desde los scripts, no se ejecutan solos):
#   funciones_A.R (generadores, Fase A) y funciones_EM.R (pasos E y M del EM, Fase C)
scripts <- c("01_datos.R",            # datos, ceros y variable de trabajo
"02_mle.R",              # Fase A: máxima verosimilitud y AIC
"03_generadores.R",      # Fase A: comprobación de generadores
"04_validacion.R",       # Fase A: QQ, KS a mano, cuantiles
"05_B1.R",               # Fase B1: Monte Carlo y muestreo por importancia
"06_B2.R",               # Fase B2: bootstrap percentil
"07_B2_completo.R",      # Fase B2: jackknife, BCa e intervalos asintóticos
"08_EM.R",               # Fase C: algoritmo EM y convergencia
"09_EM_inicios.R",       # Fase C: inicios aleatorios, tolerancias y degenerados
"10_EM_interpretacion.R",# Fase C: BIC, regímenes y cola implicada
"11_FaseD.R")            # Fase D: VaR por modelo y autocorrelación
for (s in scripts) {
cat("\n######## Ejecutando", s, "########\n")
source(s, echo = FALSE)
}
cat("\nListo. Ahora compile el informe (Knit en RStudio o rmarkdown::render()).\n")
# =====================================================================
# FASE C (parte 3) - BIC frente a una normal, interpretación de los regímenes y cola implicada
# Proyecto final - Computación Estadística 2026-II - GRUPO 2 - GBP/USD
# Requiere: funciones_EM.R y resultados/params_A.rds (de 02_mle.R)
# =====================================================================
set.seed(2026)
source("funciones_EM.R")
pA <- readRDS("resultados/params_A.rds")
archivo <- "retornos_diarios_12_series.csv"
candidatos <- c(file.path("data", archivo), archivo)
ruta <- candidatos[file.exists(candidatos)][1]
if (is.na(ruta)) stop("No encuentro el CSV. Carpeta actual: ", getwd())
datos <- read.csv(ruta, stringsAsFactors = FALSE, encoding = "UTF-8")
gbp <- datos[datos$serie == "GBP/USD", ]; gbp <- gbp[order(gbp$t), ]
r <- gbp$retorno_pct; n <- length(r); s <- sd(r)
# ---- 1. Modelo final: EM con tolerancia 1e-10; componente 1 = calma (menor desviación) -----------
ini_base <- list(pi = 0.7, mu = c(mean(r), mean(r)), sigma = c(0.5 * s, 2 * s))
fit <- em_mezcla(r, ini_base, tol = 1e-10)
th <- fit$theta
if (th$sigma[1] > th$sigma[2])
th <- list(pi = 1 - th$pi, mu = rev(th$mu), sigma = rev(th$sigma))
ll_mez <- loglik(r, th)
cat("EM final: iteraciones =", fit$iter, "| log-verosimilitud =", ll_mez, "\n")
# ---- 2. Comparación con UNA sola normal (BIC y AIC) ---------------------------------------------------
mu0 <- mean(r); sg0 <- sqrt(mean((r - mu0)^2))               # MLE de la normal única
ll_nor <- sum(log(dnorm_propia(r, mu0, sg0)))
tab_bic <- data.frame(
modelo = c("Normal única", "Mezcla de 2 normales"),
parametros = c(2, 5),
logLik = c(ll_nor, ll_mez))
tab_bic$AIC <- 2 * tab_bic$parametros - 2 * tab_bic$logLik
tab_bic$BIC <- tab_bic$parametros * log(n) - 2 * tab_bic$logLik
cat("\n== Normal única frente a mezcla ==\n")
print(tab_bic, digits = 7, row.names = FALSE)
cat("Delta BIC (normal - mezcla):", tab_bic$BIC[1] - tab_bic$BIC[2], "\n")
cat("Estadístico de razón de verosimilitud 2*(ll_mezcla - ll_normal):", 2 * (ll_mez - ll_nor),
"(NO se compara con una chi-cuadrado: ver informe)\n")
# ---- 3. Interpretación de los regímenes ---------------------------------------------------------------------
gamma  <- paso_E(r, th)           # P(calma | dato)
p_turb <- 1 - gamma               # P(turbulencia | dato)
tab_reg <- data.frame(
regimen = c("Calma", "Turbulencia"),
proporcion = c(th$pi, 1 - th$pi),
media = th$mu, desviacion = th$sigma)
cat("\n== Regímenes ==\n")
print(tab_reg, digits = 6, row.names = FALSE)
cat("Probabilidad media de turbulencia:", mean(p_turb), "(debe ser 1 - pi)\n")
cat("Días con P(turbulencia) > 0.5:", sum(p_turb > 0.5), "(", mean(p_turb > 0.5), ")\n")
cat("Días con P(turbulencia) > 0.9:", sum(p_turb > 0.9), "(", mean(p_turb > 0.9), ")\n")
cat("Días con P(turbulencia) > 0.99:", sum(p_turb > 0.99), "(", mean(p_turb > 0.99), ")\n")
cat("P(turbulencia) media en los días de retorno exactamente cero:", mean(p_turb[r == 0]), "\n")
cambios <- sum((p_turb[-1] > 0.5) != (p_turb[-n] > 0.5))
cat("Cambios de régimen día a día (corte 0.5):", cambios, "| racha media (días):", n / (cambios + 1), "\n")
orden <- order(-p_turb)
cat("15 días (t) con mayor P(turbulencia):", sort(orden[1:15]), "\n")
# ---- 4. Gráfico de la probabilidad de turbulencia en el tiempo ------------------------------------------------
dir.create("figuras", showWarnings = FALSE)
w <- 60
cs <- cumsum(c(0, p_turb))
media_movil <- (cs[(w + 1):(n + 1)] - cs[1:(n - w + 1)]) / w     # media móvil de w días
png("figuras/08_prob_turbulencia.png", width = 1400, height = 560, res = 130)
plot(gbp$t, p_turb, pch = 16, cex = 0.35, col = "grey60", ylim = c(0, 1),
xlab = "t (día)", ylab = "P(turbulencia | retorno)",
main = "Probabilidad diaria de pertenecer al régimen turbulento")
lines((1:(n - w + 1)) + (w - 1) / 2, media_movil, col = "red", lwd = 2)
abline(h = 0.5, lty = 2)
legend("topleft", c("Probabilidad diaria", paste("Media móvil de", w, "días")),
pch = c(16, NA), lty = c(NA, 1), col = c("grey60", "red"), lwd = c(NA, 2), bty = "n")
dev.off()
# ---- 5. Cola implicada: P(|r| > percentil 99 de los datos) ------------------------------------------------------
erf_propia <- function(z) {                       # serie de Taylor (101 términos): precisa para |z| moderado
k <- 0:100; fact <- c(1, cumprod(1:100))
sapply(z, function(zz) 2 / sqrt(pi) * sum((-1)^k * zz^(2 * k + 1) / (fact * (2 * k + 1))))
}
# 1 - Phi(z): serie de erf para z < 3 y fracción continua (cociente de Mills) para z >= 3,
# porque 1 - erf pierde precisión en las colas lejanas por cancelación
cola_normal <- function(z) {
sapply(z, function(zz) {
if (zz < 3) return(0.5 * (1 - erf_propia(zz / sqrt(2))))
t <- zz
for (j in 60:1) t <- zz + j / t
exp(-0.5 * zz^2) / sqrt(2 * pi) / t
})
}
# P(|X| > q) si X ~ N(mu, sigma^2):  P(X > q) + P(X < -q)
p_abs <- function(q, mu, sigma) cola_normal((q - mu) / sigma) + cola_normal((q + mu) / sigma)
q99 <- quantile(abs(r), 0.99, type = 7, names = FALSE)          # percentil 99 de |r| (retornos originales)
obs <- mean(abs(r) > q99)
p_mezcla <- th$pi * p_abs(q99, th$mu[1], th$sigma[1]) + (1 - th$pi) * p_abs(q99, th$mu[2], th$sigma[2])
p_normal <- p_abs(q99, mu0, sg0)
p_weib   <- exp(-(q99 / pA$lam_w)^pA$k_w)                       # modelo de la Fase A (sin ceros)
p0       <- mean(r == 0)
tab_cola <- data.frame(
fuente = c("Frecuencia observada", "Mezcla de 2 normales", "Weibull (Fase A)",
"Weibull (Fase A) x (1 - proporción de ceros)", "Normal única"),
probabilidad = c(obs, p_mezcla, p_weib, p_weib * (1 - p0), p_normal))
tab_cola$razon_vs_observada <- tab_cola$probabilidad / obs
cat("\n== Cola implicada: P(|r| >", q99, ") ==\n")
cat("Datos que superan el percentil 99:", sum(abs(r) > q99), "de", n, "\n")
print(tab_cola, digits = 5, row.names = FALSE)
# Verificación con la función de la librería (NO oficial)
pn <- function(z) pnorm(z)
v_mez <- th$pi * ((1 - pn((q99 - th$mu[1]) / th$sigma[1])) + pn((-q99 - th$mu[1]) / th$sigma[1])) +
(1 - th$pi) * ((1 - pn((q99 - th$mu[2]) / th$sigma[2])) + pn((-q99 - th$mu[2]) / th$sigma[2]))
cat("Verificación con pnorm (solo comprobación) - mezcla:", v_mez, " propio:", p_mezcla, "\n")
dir.create("resultados", showWarnings = FALSE)
saveRDS(list(theta = th, iter = fit$iter, tab_bic = tab_bic, tab_reg = tab_reg,
tab_cola = tab_cola, p_turb = p_turb, q99 = q99), "resultados/EM_final.rds")
cat("\nGuardado: resultados/EM_final.rds y figuras/08_prob_turbulencia.png\n")
# =====================================================================
# FASE D (parte 1) - VaR por modelo y autocorrelación (dependencia temporal)
# Proyecto final - Computación Estadística 2026-II - GRUPO 2 - GBP/USD
# Requiere: funciones_EM.R, resultados/params_A.rds, resultados/B2.rds, resultados/EM_final.rds
# =====================================================================
set.seed(2026)
source("funciones_EM.R")
pA <- readRDS("resultados/params_A.rds")
b2 <- readRDS("resultados/B2.rds")
em <- readRDS("resultados/EM_final.rds")
th <- em$theta; p_turb <- em$p_turb
archivo <- "retornos_diarios_12_series.csv"
candidatos <- c(file.path("data", archivo), archivo)
ruta <- candidatos[file.exists(candidatos)][1]
if (is.na(ruta)) stop("No encuentro el CSV. Carpeta actual: ", getwd())
datos <- read.csv(ruta, stringsAsFactors = FALSE, encoding = "UTF-8")
gbp <- datos[datos$serie == "GBP/USD", ]; gbp <- gbp[order(gbp$t), ]
r <- gbp$retorno_pct; n <- length(r); L <- -r          # L = pérdida diaria
# ---- 0. Normal estándar propia (cola y cuantil) -------------------------------------------------------
erf_propia <- function(z) {
k <- 0:100; fact <- c(1, cumprod(1:100))
sapply(z, function(zz) 2 / sqrt(pi) * sum((-1)^k * zz^(2 * k + 1) / (fact * (2 * k + 1))))
}
cola_normal <- function(z) {                    # 1 - Phi(z)
sapply(z, function(zz) {
if (zz < 3) return(0.5 * (1 - erf_propia(zz / sqrt(2))))
t <- zz
for (j in 60:1) t <- zz + j / t             # fracción continua del cociente de Mills
exp(-0.5 * zz^2) / sqrt(2 * pi) / t
})
}
bisec <- function(f, lo, hi) {                  # raíz de f (decreciente) por bisección
for (i in 1:100) { mid <- (lo + hi) / 2; if (f(mid) > 0) lo <- mid else hi <- mid }
(lo + hi) / 2
}
qnorm_propia <- function(p) bisec(function(z) cola_normal(z) - (1 - p), -6, 6)   # Q(z) decrece: Q(z) > 1-p -> subir z
cat("z_0.99 propio:", qnorm_propia(0.99), "| verificación con qnorm:", qnorm(0.99), "\n")
# ---- 1. VaR por modelo ----------------------------------------------------------------------------------
niveles <- c(0.95, 0.99, 0.995, 0.999)
mu0 <- mean(r); sg0 <- sqrt(mean((r - mu0)^2)); p0 <- mean(r == 0)
var_emp <- sapply(niveles, function(p) quantile(L, p, type = 7, names = FALSE))
var_nor <- sapply(niveles, function(p) -mu0 + qnorm_propia(p) * sg0)         # L ~ N(-mu0, sg0^2)
cola_perdida_mezcla <- function(q)                                           # P(L > q) bajo la mezcla
th$pi * cola_normal((q + th$mu[1]) / th$sigma[1]) + (1 - th$pi) * cola_normal((q + th$mu[2]) / th$sigma[2])
var_mez <- sapply(niveles, function(p) bisec(function(q) cola_perdida_mezcla(q) - (1 - p), 0, 10))
var_wei <- pA$lam_w * (-log(2 * (1 - niveles)))^(1 / pA$k_w)                 # Weibull con signos +-1/2 (sin ceros)
var_wei0 <- pA$lam_w * (-log((1 - niveles) / (0.5 * (1 - p0))))^(1 / pA$k_w) # idem, con la masa de ceros
tab_var <- data.frame(nivel = niveles, empirico = var_emp, normal = var_nor, mezcla = var_mez,
weibull_signos = var_wei, weibull_signos_ceros = var_wei0)
cat("\n== VaR diario (cuantil de la pérdida -r) por modelo ==\n")
print(tab_var, digits = 5, row.names = FALSE)
dif <- data.frame(nivel = niveles,
normal = 100 * (var_nor / var_emp - 1), mezcla = 100 * (var_mez / var_emp - 1),
weibull_signos = 100 * (var_wei / var_emp - 1))
cat("\nDiferencia porcentual frente al VaR empírico:\n"); print(dif, digits = 3, row.names = FALSE)
cat("\nIC 95% percentil del VaR 99% empírico (B2):", unlist(b2$tabla[2, c("IC95_percentil_inf", "IC95_percentil_sup")]), "\n")
cat("Pérdidas observadas por encima del nivel (n*(1-p)):", n * (1 - niveles), "\n")
# ---- 2. Autocorrelación -----------------------------------------------------------------------------------
acf_propia <- function(v, h) {
v <- v - mean(v)
sum(v[1:(length(v) - h)] * v[(1 + h):length(v)]) / sum(v^2)
}
lags <- 1:30
series <- list("r" = r, "|r|" = abs(r), "r^2" = r^2, "P(turbulencia)" = p_turb)
tab_acf <- data.frame(lag = lags,
sapply(series, function(v) sapply(lags, function(h) acf_propia(v, h))),
check.names = FALSE)
banda <- 1.96 / sqrt(n)
cat("\n== Autocorrelación muestral (banda de ruido blanco +-", banda, ") ==\n")
print(tab_acf[c(1, 2, 3, 5, 10, 20, 30), ], digits = 3, row.names = FALSE)
cat("Rezagos (de 30) fuera de la banda:\n")
print(sapply(tab_acf[, -1], function(a) sum(abs(a) > banda)))
# Efecto de diseño aproximado (ventana de Bartlett, K = 20): n_eff = n / (1 + 2 sum (1 - h/(K+1)) rho_h)
efecto <- function(v, K = 20)
1 + 2 * sum((1 - (1:K) / (K + 1)) * sapply(1:K, function(h) acf_propia(v, h)))
f_abs <- efecto(abs(r)); f_r2 <- efecto(r^2)
cat("\nEfecto de diseño aproximado: |r| =", f_abs, "(n_eff =", n / f_abs, ") | r^2 =", f_r2, "(n_eff =", n / f_r2, ")\n")
# ---- 3. Gráfico de la autocorrelación -----------------------------------------------------------------------
dir.create("figuras", showWarnings = FALSE)
png("figuras/09_acf.png", width = 1400, height = 900, res = 130)
par(mfrow = c(2, 2))
for (nm in names(series)) {
a <- tab_acf[[nm]]
plot(lags, a, type = "h", lwd = 3, ylim = range(c(a, -banda, banda)),
xlab = "rezago (días)", ylab = "autocorrelación", main = nm)
abline(h = c(-banda, banda), lty = 2, col = "red"); abline(h = 0)
}
dev.off()
dir.create("resultados", showWarnings = FALSE)
saveRDS(list(tab_var = tab_var, dif = dif, tab_acf = tab_acf, banda = banda,
efecto = c(abs = f_abs, r2 = f_r2)), "resultados/FaseD.rds")
cat("\nGuardado: resultados/FaseD.rds y figuras/09_acf.png\n")
---
title: "Riesgo de pérdida en la serie GBP/USD: simulación, remuestreo y mezclas"
